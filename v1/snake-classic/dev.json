      "blockedEvents": []
    },
    "providers": {
      "posthog": {
        "enabled": true,
        "batching": {
          "flushIntervalMs": 2000,
          "maxBatchSize": 1,
          "flushOnPageHide": true
        }
      },
      "gamefw": {
        "enabled": true,
        "batching": {
          "flushIntervalMs": 30000,
          "maxBatchSize": 100,
          "flushOnPageHide": true
        }
      }
    }
  },
  "paywall": {
    "enabled": false,
    "triggers": [
      {
        "episodeIndex": 1,
        "beforeSceneIndex": 1
      }
    ],
    "freeEpisodeLimit": 2
  },
  "freewall": {
    "enabled": false,
    "triggers": [
      {
        "episodeIndex": 1,
        "beforeSceneIndex": 1
      }
    ],
    "frequency": {
      "mode": "cooldown",
      "cooldownDays": 7
    },
    "overrides": {
      "ios": {
        "enabled": true
      },
      "android": {
        "enabled": true
      },
      "electron-mac-appstore": {
        "enabled": true
      }
    }
  },
  "profiling": {
    "enabled": true,
    "cohortPercent": 100,
    "signals": {
      "fps": true,
      "longTasks": true,
      "memory": true,
      "systems": true,
      "entities": true,
      "events": true
    }
  },
  "appUpdate": {
    "enabled": false,
    "mode": "soft",
    "platforms": [
      "ios",
      "android"
    ],
    "checkStore": true,
    "inAppUpdate": true,
    "rollout": {
      "percent": 100,
      "hardPercent": 100,
      "salt": ""
    }
  }
}
